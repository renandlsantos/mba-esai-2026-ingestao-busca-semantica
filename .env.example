# Somente uso local. Nunca commitar .env.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55433/rag
PG_VECTOR_COLLECTION_NAME=mba_esai_293_v1
PDF_PATH=document.pdf
# Deve corresponder ao host de DATABASE_URL
POSTGRES_PORT=55433

# Optional: external credential file, never copy its secrets into this repository.
# LLM_ENV_FILE=~/.config/spark/spark-api.env
# OPENAI_BASE_URL=http://your-server:4000/v1
LLM_TIMEOUT_SECONDS=300
LLM_MAX_TOKENS=4096
# Spark: OPENAI_CHAT_MODEL=spark/code; OPENAI_EMBEDDING_MODEL=spark/embed.
# Use a separate database/Compose project for a different embedding model.
